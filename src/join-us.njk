---
layout: layout.njk
title: "Join Us | Careers at Altaris Growth Partners"
description: "Open roles at Altaris Growth Partners: Senior Growth Advisor, Financial Systems Lead, and Client Operations Associate."
permalink: "/join-us/"
schema1: |
  {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://altarisgrowth.com/"},{"@type":"ListItem","position":2,"name":"Join Us"}]}
eleventyComputed:
  schema2: |
    [
      {% for role in collections.openRoles %}
      {
        "@context": "https://schema.org",
        "@type": "JobPosting",
        "title": {{ role.data.title | dump | safe }},
        "description": {{ role.data.description | dump | safe }},
        "employmentType": "FULL_TIME",
        "hiringOrganization": { "@type": "Organization", "name": "Altaris Growth Partners Inc.", "sameAs": "https://altarisgrowth.com/" },
        "jobLocationType": "TELECOMMUTE",
        "applicantLocationRequirements": { "@type": "Country", "name": "Canada" }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
---
<section class="page-hero parallax-section">
  <div class="photo-layer parallax-layer" data-speed="0.12" style="background-image:url('https://picsum.photos/seed/altaris-team/1800/800');"></div>
  <div class="photo-tint brass-edge"></div>
  <div class="container">
    <p class="breadcrumb"><a href="/">Home</a> / <span>Join Us</span></p>
    <p class="eyebrow">{{ pages['join-us'].eyebrow }}</p>
    <h1>{{ pages['join-us'].h1 }}</h1>
    <p class="lede">{{ pages['join-us'].lede }}</p>
  </div>
</section>

<section class="join-us parallax-section">
  <div class="photo-layer parallax-layer" data-speed="0.15" style="background-image:url('https://picsum.photos/seed/altaris-team/1800/1100');"></div>
  <div class="photo-tint"></div>
  <div class="container">
    <div class="join-inner reveal">
      <p class="eyebrow" style="color:var(--brass-deep);">Open Roles</p>
      <div class="role-list">
        {% for role in collections.openRoles %}
        <div class="role-row">
          <span>{{ role.data.title }}</span>
          <span>{{ role.data.location }}</span>
        </div>
        {% endfor %}
      </div>
      <div class="btn-row" style="margin-top:2rem;">
        <a href="/contact/" class="btn-primary">Apply now</a>
      </div>
    </div>
  </div>
</section>
