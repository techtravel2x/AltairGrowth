      <!--
        Netlify Forms: detected automatically at build time because of
        name + data-netlify="true". No external service, no API key.
        Submissions land in Site configuration -> Forms in the Netlify
        dashboard, and email notifications can be turned on there too
        (Notifications -> Email notification -> Form submission).
      -->
      <form class="contact-form reveal" id="contactForm" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact">
        <p class="hp-field"><label>Leave this empty: <input name="bot-field"></label></p>
        <input type="text" name="name" placeholder="Full name" aria-label="Full name" required>
        <input type="email" name="email" placeholder="Work email" aria-label="Work email" required>
        <input type="text" name="company" placeholder="Company name" aria-label="Company name">
        <textarea name="message" placeholder="What's the current state of the business?" aria-label="Message" required></textarea>
        <button type="submit" class="btn-primary">Send message</button>
        <div class="form-status" id="formStatus" role="status" aria-live="polite"></div>
        <p class="site-footer-note">We reply within one business day. Your information is never shared.</p>
      </form>
    </div>
