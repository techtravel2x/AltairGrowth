---
layout: layout.njk
title: "Insights | Altaris Growth Partners"
description: "Practical reads on enterprise value, founder dependency, and KPI systems from the Altaris advisory team."
permalink: "/insights/"
schema1: |
  {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://altarisgrowth.com/"},{"@type":"ListItem","position":2,"name":"Insights"}]}
schema2: |
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "Altaris Insights",
    "url": "https://altarisgrowth.com/insights/"
  }
---
<section class="page-hero parallax-section">
  <div class="photo-layer parallax-layer" data-speed="0.12" style="background-image:url('https://picsum.photos/seed/altaris-insight1/1800/800');"></div>
  <div class="photo-tint brass-edge"></div>
  <div class="container">
    <p class="breadcrumb"><a href="/">Home</a> / <span>Insights</span></p>
    <p class="eyebrow">{{ pages.insights.eyebrow }}</p>
    <h1>{{ pages.insights.h1 }}</h1>
    <p class="lede">{{ pages.insights.lede }}</p>
  </div>
</section>

<section class="insights">
  <div class="container">
    <div class="insight-grid">
      {% for post in collections.insightPosts %}
      <a href="{{ post.url }}" class="insight-card" style="display:block;">
        <div class="card-thumb"><img src="{{ post.data.thumbnail }}" alt="{{ post.data.title }}" loading="lazy"></div>
        <div class="meta">{{ post.data.category }} · {{ post.data.read_time }} min read</div>
        <h3>{{ post.data.title }}</h3>
        <p>{{ post.data.excerpt }}</p>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="cta-band">
  <div class="container">
    <p class="eyebrow" style="justify-content:center;display:flex;">Start Here</p>
    <h2>Find out what's limiting your enterprise value.</h2>
    <p>Take the free assessment — a structured look at where your business stands today, and what's holding back tomorrow's valuation.</p>
    <a href="{{ site.assessUrl }}" class="btn-primary" target="_blank" rel="noopener">Take the free assessment</a>
  </div>
</section>
