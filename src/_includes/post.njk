---
layout: layout.njk
eleventyComputed:
  schema1: |
    {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://altarisgrowth.com/"},{"@type":"ListItem","position":2,"name":"Insights","item":"https://altarisgrowth.com/insights/"},{"@type":"ListItem","position":3,"name":"{{ title }}"}]}
  schema2: |
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ title | dump | safe }},
      "description": {{ excerpt | dump | safe }},
      "datePublished": {{ date | dump | safe }},
      "author": { "@type": "Organization", "name": "Altaris Growth Partners Inc." }
    }
---
<section class="page-hero parallax-section" style="min-height:30vh;">
  <div class="photo-layer parallax-layer" data-speed="0.12" style="background-image:url('{{ thumbnail or 'https://picsum.photos/seed/altaris-insight1/1800/800' }}');"></div>
  <div class="photo-tint brass-edge"></div>
  <div class="container">
    <p class="breadcrumb"><a href="/">Home</a> / <a href="/insights/">Insights</a> / <span>{{ title }}</span></p>
    <p class="eyebrow">{{ category }} · {{ read_time }} min read</p>
    <h1>{{ title }}</h1>
  </div>
</section>

<section class="insights" style="padding-top:4rem;">
  <div class="container" style="max-width:760px;">
    <article>
      {{ content | safe }}
    </article>
    <p style="margin-top:3rem;"><a href="/insights/" class="btn-ghost">← Back to Insights</a></p>
  </div>
</section>
