<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="robots" content="index, follow">
<link rel="canonical" href="https://altarisgrowth.com{{ page.url }}">
<link rel="icon" type="image/png" href="/assets/logo-black.png">

<meta property="og:type" content="website">
<meta property="og:site_name" content="Altaris Growth Partners">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="https://altarisgrowth.com{{ page.url }}">
<meta property="og:image" content="https://altarisgrowth.com/assets/logo-parchment.png">
<meta property="og:locale" content="en_US">

<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,400&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/styles.css">

{% if schema1 %}
<script type="application/ld+json">
{{ schema1 | safe }}
</script>
{% endif %}
{% if schema2 %}
<script type="application/ld+json">
{{ schema2 | safe }}
</script>
{% endif %}
</head>
<body>

<a href="#main" class="skip-link">Skip to content</a>

<header class="site-header">
  <nav class="nav">
    <a href="/" class="wordmark"><img src="/assets/logo-parchment.png" alt="Altaris Growth Partners Inc. logo" width="200" height="51"></a>
    <ul class="nav-links" id="navLinks">
      <li><a href="/"{% if page.url == "/" %} class="active"{% endif %}>Home</a></li>
      <li><a href="/growth-strategies/"{% if page.url == "/growth-strategies/" %} class="active"{% endif %}>Growth Strategies</a></li>
      <li><a href="/how-it-works/"{% if page.url == "/how-it-works/" %} class="active"{% endif %}>How It Works</a></li>
      <li><a href="{{ site.assessUrl }}" target="_blank" rel="noopener">Free Assessment</a></li>
      <li><a href="/resources/"{% if page.url == "/resources/" %} class="active"{% endif %}>Resources</a></li>
      <li><a href="/industries/"{% if page.url == "/industries/" %} class="active"{% endif %}>Industries</a></li>
      <li><a href="/faq/"{% if page.url == "/faq/" %} class="active"{% endif %}>FAQ</a></li>
      <li><a href="/insights/"{% if page.url.startsWith("/insights") %} class="active"{% endif %}>Insights</a></li>
      <li><a href="/join-us/"{% if page.url == "/join-us/" %} class="active"{% endif %}>Join Us</a></li>
      <li><a href="/contact/"{% if page.url == "/contact/" %} class="active"{% endif %}>Contact</a></li>
    </ul>
    <a href="{{ site.assessUrl }}" class="nav-cta" target="_blank" rel="noopener">Assess My Business</a>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">☰</button>
  </nav>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer>
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href="/" class="wordmark" style="color:var(--parchment);"><img src="/assets/logo-parchment.png" alt="Altaris Growth Partners Inc. logo" width="200" height="51"></a>
        <p style="margin-top:1rem;max-width:32ch;font-size:.86rem;">Strategic growth partner for founders scaling small to mid-sized enterprises.</p>
      </div>
      <div class="foot-cols">
        <ul>
          <h4>Site</h4>
          <li><a href="/">Home</a></li>
          <li><a href="/growth-strategies/">Growth Strategies</a></li>
          <li><a href="/how-it-works/">How It Works</a></li>
          <li><a href="{{ site.assessUrl }}" target="_blank" rel="noopener">Free Assessment</a></li>
          <li><a href="/resources/">Resources</a></li>
        </ul>
        <ul>
          <h4>More</h4>
          <li><a href="/industries/">Industries</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/insights/">Insights</a></li>
          <li><a href="/join-us/">Join Us</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
    </div>
    <p class="foot-bottom">© 2026 Altaris Growth Partners Inc. All rights reserved.</p>
  </div>
</footer>

<script src="/assets/script.js"></script>
</body>
</html>
