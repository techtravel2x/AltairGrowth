---
layout: layout.njk
title: "FAQ | Altaris Growth Partners"
description: "Answers to common questions about working with Altaris Growth Partners, from engagement length to which industries we serve."
permalink: "/faq/"
schema1: |
  {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://altarisgrowth.com/"},{"@type":"ListItem","position":2,"name":"FAQ"}]}
eleventyComputed:
  schema2: |
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for item in collections.faqItems %}
        {
          "@type": "Question",
          "name": {{ item.data.question | dump | safe }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ item.templateContent | striptags | trim | dump | safe }} }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
---
<section class="page-hero parallax-section">
  <div class="photo-layer parallax-layer" data-speed="0.12" style="background-image:url('https://picsum.photos/seed/altaris-consult/1800/800');"></div>
  <div class="photo-tint brass-edge"></div>
  <div class="container">
    <p class="breadcrumb"><a href="/">Home</a> / <span>FAQ</span></p>
    <p class="eyebrow">Frequently Asked</p>
    <h1>Before you take the assessment.</h1>
    <p class="lede">Straight answers to the questions we hear most from founders considering Altaris.</p>
  </div>
</section>

<section class="faq">
  <div class="container">
    <div class="faq-layout">
      <div class="faq-list">
        {% for item in collections.faqItems %}
        <div class="faq-item{% if loop.first %} open{% endif %}">
          <button class="faq-q" aria-expanded="{% if loop.first %}true{% else %}false{% endif %}">{{ item.data.question }}</button>
          <div class="faq-a">{{ item.templateContent | safe }}</div>
        </div>
        {% endfor %}
      </div>
      <div class="inset-figure">
        <img src="https://picsum.photos/seed/altaris-consult/800/900" alt="Advisory conversation between founder and Altaris team" loading="lazy">
        <span class="fig-cap">A structured first conversation</span>
      </div>
    </div>
  </div>
</section>

<section class="cta-band">
  <div class="container">
    <p class="eyebrow" style="justify-content:center;display:flex;">Start Here</p>
    <h2>Find out what's limiting your enterprise value.</h2>
    <p>Take the free assessment — a structured look at where your business stands today, and what's holding back tomorrow's valuation.</p>
    <a href="{{ site.assessUrl }}" class="btn-primary" target="_blank" rel="noopener">Take the free assessment</a>
  </div>
</section>
